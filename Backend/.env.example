# ============================================================
# Victory School Backend – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit files with real secrets.
# ============================================================

NODE_ENV=development

# Server
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/victory-school

# JWT signing secret – use a long random string in production
JWT_SECRET=

# Allowed CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# ── Seed script only ────────────────────────────────────────
# Required only when running: npm run seed
SEED_ADMIN_EMAIL=admin@victory.school
SEED_ADMIN_PASSWORD=
