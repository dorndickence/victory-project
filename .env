# ============================================================
# Victory School Management System – Environment Variables
# Copy this file to .env (frontend) and Backend/.env (backend),
# then fill in real values. NEVER commit files with real secrets.
# ============================================================

# ── Frontend (Vite) ─────────────────────────────────────────
# Google Gemini API key for the AI assistant
GEMINI_API_KEY=

# Base URL of the backend API (no trailing slash)
VITE_API_URL=https://victory-project-production.up.railway.app/api/v1
